{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      // --- Gradle wrapper (Bash/Git-Bash Y PowerShell/.bat) ---
      "Bash(./gradlew:*)",
      "Bash(gradlew:*)",
      "PowerShell(./gradlew*)",
      "PowerShell(.\\gradlew*)",
      "PowerShell(gradlew*)",
      "Bash(./gradlew.bat:*)",
      "Bash(gradlew.bat:*)",
      "PowerShell(./gradlew.bat*)",
      "PowerShell(.\\gradlew.bat*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(xargs:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(javap:*)",
      "PowerShell(java *)",
      "PowerShell(scoop *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-PSDrive *)",
      "PowerShell(.\\gradlew.bat*)",

      "Skill(update-config)",

      // --- Android SDK / dispositivo / instrumentación ---
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(avdmanager:*)",
      "Bash(sdkmanager:*)",
      "Bash(apksigner:*)",
      "Bash(zipalign:*)",
      "Bash(keytool:*)",
      "PowerShell(adb*)",
      "PowerShell(emulator*)",
      "PowerShell(avdmanager*)",
      "PowerShell(sdkmanager*)",
      "PowerShell(apksigner*)",
      "PowerShell(zipalign*)",
      "PowerShell(java*)",
      "PowerShell(scoop *)",

      // --- Git (lectura + trabajo normal, sin push/reset destructivo) ---
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",

      // --- Utilidades de shell (lectura / navegación / texto / archivos) ---
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "Bash(unzip:*)",

      // --- PowerShell utilidades ---
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(New-Item *)",
      "PowerShell(Expand-Archive *)",
      "PowerShell(Where-Object *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(Measure-Object *)",

      // --- Herramientas de archivo de Claude ---
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/keystore.properties)"
    ]
  }
}