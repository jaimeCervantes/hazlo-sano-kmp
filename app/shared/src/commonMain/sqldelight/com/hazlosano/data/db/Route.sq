-- Routes: the tracks you intend to follow, imported from GPX or kept from an outing you recorded.
-- Separate from MovementSessionEntity on purpose — a session is what happened on a given day, a
-- route outlives it — and joined to it only by MovementSessionEntity.routeId, when an outing was
-- recorded while following one.
--
-- distance and elevationGain are stored, like the session's distanceTraveled and for the same
-- reason: the route list must draw without reading every point of every route. They are summaries
-- of the points, refreshed when a route is written, not a second source of truth.
--
-- elevationGain is nullable because that summary is exactly what the list has to trust. A route
-- whose points carry no elevation has no measured climb, and storing 0.0 made "unknown"
-- indistinguishable from "flat" — with no points loaded, the list had no way to tell them apart
-- and drew "0 m" for both.

CREATE TABLE IF NOT EXISTS RouteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    distance REAL NOT NULL,             -- meters
    elevationGain REAL,                 -- meters; null when no point carried an elevation
    -- Recognises the same track under a different name, which a name comparison cannot. Nullable
    -- because a route with no points has nothing to fingerprint.
    fingerprint TEXT,
    createdAt INTEGER NOT NULL          -- epoch millis
);

-- altitude and timestamp are nullable because GPX makes both optional: a route drawn on a map has
-- no times, and plenty of exporters omit elevation. Storing a missing elevation as 0.0 would put
-- the track at sea level.
CREATE TABLE IF NOT EXISTS RoutePointEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    routeId INTEGER NOT NULL,
    seq INTEGER NOT NULL,               -- order along the route
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    altitude REAL,
    timestamp INTEGER,
    FOREIGN KEY(routeId) REFERENCES RouteEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_route_fingerprint ON RouteEntity(fingerprint);
CREATE INDEX IF NOT EXISTS idx_route_point_route ON RoutePointEntity(routeId, seq);

selectAllRoutes:
SELECT *
FROM RouteEntity
ORDER BY createdAt DESC;

selectRouteById:
SELECT *
FROM RouteEntity
WHERE id = ?;

selectRouteByName:
SELECT *
FROM RouteEntity
WHERE name = ?
LIMIT 1;

selectRouteByFingerprint:
SELECT *
FROM RouteEntity
WHERE fingerprint = ?
LIMIT 1;

selectPointsByRoute:
SELECT *
FROM RoutePointEntity
WHERE routeId = ?
ORDER BY seq ASC;

insertRoute:
INSERT INTO RouteEntity(name, distance, elevationGain, fingerprint, createdAt)
VALUES (?, ?, ?, ?, ?);

lastInsertedRouteId:
SELECT last_insert_rowid();

updateRoute:
UPDATE RouteEntity
SET name = ?, distance = ?, elevationGain = ?, fingerprint = ?
WHERE id = ?;

renameRoute:
UPDATE RouteEntity
SET name = ?
WHERE id = ?;

insertRoutePoint:
INSERT INTO RoutePointEntity(routeId, seq, latitude, longitude, altitude, timestamp)
VALUES (?, ?, ?, ?, ?, ?);

deletePointsByRoute:
DELETE FROM RoutePointEntity
WHERE routeId = ?;

deleteRoute:
DELETE FROM RouteEntity
WHERE id = ?;
