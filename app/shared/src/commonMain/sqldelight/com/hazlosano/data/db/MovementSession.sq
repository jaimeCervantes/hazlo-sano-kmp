-- Movement pillar tables in the shared HazloSanoDatabase.
-- Pillar-prefixed names keep the single multi-pillar database organized alongside
-- SleepSessionEntity, ProductEntity, etc. A session has many points (1-to-N).
--
-- The session row holds only what listing sessions needs. Climb, descent, altitudes and time spent
-- moving are all pure functions of MovementPointEntity, so they are computed when a session is
-- opened instead of stored: a stored figure is frozen at the algorithm that wrote it, which would
-- leave every session already recorded reporting the old number after any improvement.
--
-- distanceTraveled is the deliberate exception. It is derivable too, but the history must be able
-- to list sessions without reading every point of every one of them, so it is kept as a summary and
-- refreshed by updateDistance when a session is opened.

CREATE TABLE IF NOT EXISTS MovementSessionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    routeId INTEGER,
    name TEXT NOT NULL,
    date INTEGER NOT NULL,              -- epoch millis
    elapsedTime INTEGER NOT NULL,       -- seconds, wall clock from start to stop
    distanceTraveled REAL NOT NULL      -- meters, summary refreshed on read
);

CREATE TABLE IF NOT EXISTS MovementPointEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId INTEGER NOT NULL,
    seq INTEGER NOT NULL,               -- order within the session
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    altitude REAL NOT NULL,
    accuracy REAL NOT NULL,
    bearing REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    FOREIGN KEY(sessionId) REFERENCES MovementSessionEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_movement_session_date ON MovementSessionEntity(date);
CREATE INDEX IF NOT EXISTS idx_movement_point_session ON MovementPointEntity(sessionId, seq);

insertSession:
INSERT INTO MovementSessionEntity(routeId, name, date, elapsedTime, distanceTraveled)
VALUES (?, ?, ?, ?, ?);

lastInsertedSessionId:
SELECT last_insert_rowid();

insertPoint:
INSERT INTO MovementPointEntity(
    sessionId, seq, latitude, longitude, altitude, accuracy, bearing, timestamp
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateDistance:
UPDATE MovementSessionEntity
SET distanceTraveled = ?
WHERE id = ?;

selectAllSessions:
SELECT *
FROM MovementSessionEntity
ORDER BY date DESC;

selectPointsBySession:
SELECT *
FROM MovementPointEntity
WHERE sessionId = ?
ORDER BY seq ASC;
