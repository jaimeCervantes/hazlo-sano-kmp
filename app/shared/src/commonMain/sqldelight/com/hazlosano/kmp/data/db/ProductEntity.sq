CREATE TABLE IF NOT EXISTS ProductEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    price REAL NOT NULL,
    isAvailable INTEGER NOT NULL DEFAULT 1,
    description TEXT,
    category TEXT NOT NULL,
    subCategory TEXT,
    tags TEXT NOT NULL DEFAULT '[]',
    imageUrl TEXT,
    productUrl TEXT,
    sellerId TEXT,
    FOREIGN KEY (sellerId) REFERENCES SellerEntity(id)
);

CREATE INDEX IF NOT EXISTS idx_product_category ON ProductEntity(category);
CREATE INDEX IF NOT EXISTS idx_product_seller ON ProductEntity(sellerId);

searchByText:
SELECT *
FROM ProductEntity
WHERE isAvailable = 1
  AND (name LIKE '%' || ? || '%' OR description LIKE '%' || ? || '%' OR category LIKE '%' || ? || '%')
ORDER BY name ASC
LIMIT ? OFFSET ?;

selectByCategory:
SELECT *
FROM ProductEntity
WHERE isAvailable = 1
  AND category = ?
ORDER BY name ASC
LIMIT ? OFFSET ?;

selectAll:
SELECT *
FROM ProductEntity
WHERE isAvailable = 1
ORDER BY name ASC
LIMIT ? OFFSET ?;

selectById:
SELECT *
FROM ProductEntity
WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO ProductEntity(id, name, price, isAvailable, description, category, subCategory, tags, imageUrl, productUrl, sellerId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

countAll:
SELECT COUNT(*) FROM ProductEntity;

deleteAll:
DELETE FROM ProductEntity;
