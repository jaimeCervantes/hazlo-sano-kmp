    <!-- Permission rationale -->
    <string name="permission_rationale_title">Sleep &amp; Rest</string>
    <string name="permission_rationale_message">The Sleep &amp; Rest pillar uses your phone\'s sensors to measure your rest habits while you sleep. This helps understand your patterns and improve your metabolic and mental health.\n\nThe app does not record audio or video. It only detects whether you are asleep or awake using motion and ambient light sensors.</string>
    <string name="permission_activate">Enable</string>
    <string name="permission_not_now">Not now</string>
    <string name="permission_denied_title">Permission Required</string>
    <string name="permission_denied_message">Without the Physical Activity permission, the app cannot automatically measure your sleep. You can enable it manually in Settings > Apps > Hazlo Sano > Permissions.</string>
    <string name="permission_go_settings">Go to Settings</string>
    <string name="permission_cancel">Cancel</string>

