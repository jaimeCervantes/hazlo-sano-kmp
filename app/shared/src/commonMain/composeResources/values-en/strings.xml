    <!-- The four pillars -->
    <string name="pillar_sleep">Sleep</string>
    <string name="pillar_nutrition">Nutrition</string>
    <string name="pillar_movement">Movement</string>
    <string name="pillar_mind">Mind and Spirit</string>
