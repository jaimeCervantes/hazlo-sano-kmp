    <string name="pillar_info_open">What this pillar is</string>
    <string name="pillar_info_practice_label">The practice</string>
    <string name="pillar_info_sleep_title">Sleep and Rest</string>
    <string name="pillar_info_sleep_tagline">Sleeping to the rhythm of daylight again, not of screens.</string>
    <string name="pillar_info_sleep_body">Rest is the physiological basis of attention, memory, emotional stability, metabolism, immunity and heart health. Sleeping well is the first step towards a body and a mind that can repair themselves.</string>
    <string name="pillar_info_sleep_practice">From dusk to dawn</string>
    <string name="pillar_info_nutrition_title">Natural, nourishing, local food</string>
    <string name="pillar_info_nutrition_tagline">Reconnecting with where food comes from, its season, and who grows it.</string>
    <string name="pillar_info_nutrition_body">Real food: barely processed, varied, in season and from nearby. This pillar brings the people who grow it closer to the people who eat it, so that eating well becomes the easiest option.</string>
    <string name="pillar_info_nutrition_practice">A real, local supper at dusk</string>
    <string name="pillar_info_movement_title">Natural, local, shared movement</string>
    <string name="pillar_info_movement_tagline">Getting your body back on the street, the trail and the local court.</string>
    <string name="pillar_info_movement_body">Moving is not only the gym: it is walking, cycling, playing, planting or training at a studio around the corner. The idea is to give physical activity back to everyday life and to the place you live in.</string>
    <string name="pillar_info_movement_practice">Living, local, functional movement</string>
    <string name="pillar_info_mind_title">Mind, spirit and the people nearby</string>
    <string name="pillar_info_mind_tagline">Getting back silence, presence, and the people who live close by.</string>
    <string name="pillar_info_mind_body">Emotional care, mental clarity and the bond with the people who live nearby, held together by a purpose. Healthy relationships and a sense of belonging strengthen the other three pillars.</string>
    <string name="pillar_info_mind_practice">Presence, peace and local connection</string>

